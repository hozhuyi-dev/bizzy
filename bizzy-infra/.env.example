PROJECT_NAME=bizzy
AWS_ACCOUNT_ID=
AWS_REGION=
# Comma-separated app origins, each ending in "/". The app redirects to its
# own origin after sign-in and sign-out, so both lists hold the same URLs.
# development: http://localhost:4200/
CALLBACK_URLS=
LOGOUT_URLS=
# The only Google account granted access in this environment.
ALLOWED_EMAIL=
# Google OAuth client used by Cognito for "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar the daily sync reads: her email address for her main calendar,
# or a test calendar's ID for development and staging.
GOOGLE_CALENDAR_ID=
# IANA time zone for the daily sync.
SYNC_TIME_ZONE=Asia/Kuala_Lumpur
